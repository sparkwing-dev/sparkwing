FROM --platform=$BUILDPLATFORM golang:1.26.10-alpine@sha256:a2012b4a1d1f9f7e9f44e0d39b805a901e856b1dd80b4e6ee4338db547050308 AS build
ARG TARGETOS TARGETARCH SPARKWING_VERSION GO_TAGS
WORKDIR /src
COPY . .

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p /out && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build \
      -trimpath \
      -tags "${GO_TAGS}" \
      -ldflags="-s -w -X main.Version=${SPARKWING_VERSION}" \
      -o /out/sparkwing-runner \
      ./cmd/sparkwing-runner

FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS runtime
ARG SPARKWING_IMAGE_REFRESH=local
RUN test -n "${SPARKWING_IMAGE_REFRESH}" && \
    apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
      bash ca-certificates coreutils curl git git-lfs gzip jq lsof make netcat-openbsd openssh-client \
      procps tar unzip util-linux xz-utils && \
    rm -rf /var/lib/apt/lists/*
# safety: OpenSSH aborts when the Kubernetes uid has no passwd entry.
RUN echo "sparkwing:x:1000:1000::/tmp:/usr/sbin/nologin" >> /etc/passwd
# safety: cache misses compile consumer pipelines with this matching toolchain.
COPY --from=golang:1.26.10-bookworm@sha256:632dff7351799a5a9954a48dc06670ade72ee44e8c351cdc0e5a57af2fea21af /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH \
    GOCACHE=/tmp/.gocache \
    GOPATH=/tmp/.gopath
# safety: TypeScript pipelines run on this Node.js, and the SDK needs 22.18 or later; only node and npm are taken.
COPY --from=node:22.23.3-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22.23.3-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
COPY bin/check-runner-image.sh /usr/local/bin/check-runner-image.sh
COPY build/runner-tools /usr/local/share/sparkwing/runner-tools
RUN /bin/sh /usr/local/bin/check-runner-image.sh
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/sparkwing-runner"]

FROM runtime AS release
ARG TARGETARCH
COPY --chmod=0755 dist/sparkwing-runner-linux-${TARGETARCH} /usr/local/bin/sparkwing-runner

FROM runtime AS source
COPY --from=build /out/sparkwing-runner /usr/local/bin/sparkwing-runner
