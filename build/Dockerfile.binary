FROM --platform=$BUILDPLATFORM golang:1.27.4-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS build
ARG TARGETOS TARGETARCH BINARY SPARKWING_VERSION GO_TAGS
WORKDIR /src
COPY . .

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p /out && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build \
      -trimpath \
      -tags "${GO_TAGS}" \
      -ldflags="-s -w -X main.Version=${SPARKWING_VERSION}" \
      -o /out/${BINARY} \
      ./cmd/${BINARY}

FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b AS runtime
ARG SPARKWING_IMAGE_REFRESH=local
RUN test -n "${SPARKWING_IMAGE_REFRESH}" && \
    apk upgrade --no-cache && \
    apk add --no-cache ca-certificates git openssh-client
# safety: OpenSSH aborts when the Kubernetes uid has no passwd entry.
RUN echo "sparkwing:x:1000:1000::/tmp:/sbin/nologin" >> /etc/passwd
ARG BINARY
ENV BINARY=${BINARY}
USER 65534:65534
# safety: shell expansion selects BINARY while exec preserves PID 1 signals.
ENTRYPOINT ["/bin/sh", "-c", "exec /usr/local/bin/${BINARY} \"$@\"", "--"]

FROM runtime AS release
ARG BINARY TARGETARCH
COPY --chmod=0755 dist/${BINARY}-linux-${TARGETARCH} /usr/local/bin/${BINARY}

FROM runtime AS source
ARG BINARY
COPY --from=build /out/${BINARY} /usr/local/bin/${BINARY}
