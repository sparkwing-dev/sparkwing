FROM --platform=$BUILDPLATFORM golang:1.26.6-alpine@sha256:3889b425f035be855a72fb4755265311293b6d414521f0a519d819df32222d83 AS build
ARG TARGETOS TARGETARCH BINARY SPARKWING_VERSION
WORKDIR /src
COPY . .

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p /out && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build \
      -trimpath \
      -ldflags="-s -w -X main.Version=${SPARKWING_VERSION}" \
      -o /out/${BINARY} \
      ./cmd/${BINARY}

FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
RUN apk upgrade --no-cache && \
    apk add --no-cache ca-certificates git openssh-client
# safety: OpenSSH aborts when the Kubernetes uid has no passwd entry.
RUN echo "sparkwing:x:1000:1000::/tmp:/sbin/nologin" >> /etc/passwd
ARG BINARY
ENV BINARY=${BINARY}
COPY --from=build /out/${BINARY} /usr/local/bin/${BINARY}
USER 65534:65534
# safety: shell expansion selects BINARY while exec preserves PID 1 signals.
ENTRYPOINT ["/bin/sh", "-c", "exec /usr/local/bin/${BINARY} \"$@\"", "--"]
