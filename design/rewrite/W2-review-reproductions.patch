+func TestReviewLocalFirstPlacementHoldsForLivePreferredRunner(t *testing.T) {
+	e, _ := engineRuntimeStore(t)
+	engineRuntimeClaim(t, e, capability.UnitTrigger)
+	engineSQL(t, e.Store, `INSERT INTO nodes(team,run_id,node_id,status,ready_at,spec_json,execution_json) VALUES ('a','run','job','pending',?,?,?)`, time.Now().UnixNano(), []byte(`{"id":"job"}`), []byte(`{}`))
+	e.Store.SetClaimProfileResolver(engineEnrollmentFunc(func(_ context.Context, p capability.Principal) (match.Profile, match.Resources, error) {
+		location := "cloud"
+		if p.Capability.Subject.ID == "preferred" {
+			location = "local"
+		}
+		return match.Profile{Location: location, Capacity: match.Resources{Cores: 1}}, match.Resources{Cores: 1}, nil
+	}))
+	e.RunnerPolicy = runnerAdmissionFunc(func(context.Context, string) error { return nil })
+	raw := engineHTTPRoot(t, e, "a", "fallback", []capability.Grant{capability.NodesClaim})
+	engineHTTPRoot(t, e, "a", "preferred", []capability.Grant{capability.NodesClaim})
+	if err := e.Store.RecordAgentLabels(t.Context(), "preferred", nil); err != nil {
+		t.Fatal(err)
+	}
+	h := New(e.Store, nil).WithEngineController(e).WithLocalFirstPlacement([]string{"location=local"}, time.Hour, time.Hour).Handler()
+	w := engineClaimHTTP(t, h, raw, "POST", "/api/v1/runners/claim", `{"runner_version":"v1","kinds":["node"],"available_cores":1}`, 200)
+	var result controllerwire.ClaimResponse
+	if err := json.Unmarshal(w.Body.Bytes(), &result); err != nil {
+		t.Fatal(err)
+	}
+	if result.Claim != nil {
+		t.Fatalf("fallback claimed %s while a live eligible preferred runner had capacity", result.Claim.JobID)
+	}
+}
