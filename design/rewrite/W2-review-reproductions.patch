+func reviewIntakeStore(t *testing.T) (*Server, *store.Tenant) {
+	t.Helper()
+	st, err := teststore.Open(filepath.Join(t.TempDir(), "intake.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := st.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	if err := st.AsOperator().CreateTeam(t.Context(), "intake-review"); err != nil {
+		t.Fatal(err)
+	}
+	tenant, err := st.ForTeam(t.Context(), "intake-review")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return New(st, nil), tenant
+}
