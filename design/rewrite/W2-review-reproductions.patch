+func TestReviewDerivedSessionCannotProvisionDetachedRoot(t *testing.T) {
+	e, _ := engineRuntimeStore(t)
+	st := e.Store
+	engineSQL(t, st, `INSERT INTO accounts(id,email,created_at,updated_at) VALUES ('account','account@example.test',1,1)`)
+	engineSQL(t, st, `INSERT INTO memberships(team,account_id,role,created_at) VALUES ('a','account','editor',1)`)
+	cipher, err := secrets.NewCipher(make([]byte, secrets.KeySize))
+	if err != nil {
+		t.Fatal(err)
+	}
+	st.SetSessionKeyCipher(cipher)
+	raw, _, _, err := st.CreateAccountSession(t.Context(), store.Account{ID: "account", Email: "account@example.test"}, "a", time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	digest := sha256.Sum256([]byte(raw))
+	parent := capability.AuthorityRef{Kind: capability.AuthoritySession, ID: hex.EncodeToString(digest[:])}
+	limited, err := st.ProvisionCapability(t.Context(), capability.ProvisionSpec{Kind: capability.ProvisionMember, Authority: &parent, Subject: capability.Subject{Kind: capability.SubjectAccount, ID: "account"}, Team: "a", Grants: []capability.Grant{capability.RunsRead}, Binding: capability.Binding{Kind: capability.BindingNone}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	derivedRaw, _, err := st.CreateCapabilitySession(t.Context(), limited.Capability.Prefix, time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	digest = sha256.Sum256([]byte(derivedRaw))
+	derived := capability.AuthorityRef{Kind: capability.AuthoritySession, ID: hex.EncodeToString(digest[:])}
+	issued, err := st.ProvisionCapability(t.Context(), capability.ProvisionSpec{Kind: capability.ProvisionMember, Authority: &derived, Subject: capability.Subject{Kind: capability.SubjectAccount, ID: "account"}, Team: "a", Grants: []capability.Grant{capability.RunsRead}, Binding: capability.Binding{Kind: capability.BindingNone}})
+	if err == nil {
+		t.Fatalf("derived session provisioned detached root %s with parent %v", issued.Capability.Prefix, issued.Capability.Parent)
+	}
+}
