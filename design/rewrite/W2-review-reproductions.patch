+func reviewNativeImplementation[T any](t *testing.T, value any) {
+	t.Helper()
+	name := reflect.TypeFor[T]().Name()
+	t.Run(name, func(t *testing.T) {
+		if _, ok := value.(T); !ok {
+			t.Fatalf("%T does not implement %s", value, name)
+		}
+	})
+}
