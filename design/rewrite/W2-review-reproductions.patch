+func TestReviewDueScheduleCreatesSealedRun(t *testing.T) {
+	srv, tenant := reviewIntakeStore(t)
+	schedule := store.CronSchedule{
+		ID: "nightly", Team: tenant.Team(), Pipeline: "ci",
+		RepoPath: "https://github.com/acme/widgets.git", GitBranch: "main",
+		LockedRef: "0123456789abcdef0123456789abcdef01234567", ArmedBy: "account:editor",
+	}
+	id, err := (cronLauncher{server: srv}).Launch(t.Context(), schedule, time.Date(2026, 10, 15, 12, 0, 0, 0, time.UTC))
+	if err != nil {
+		t.Fatalf("due schedule intake: %v", err)
+	}
+	run, err := tenant.ReadRun(t.Context(), id)
+	if err != nil || run.Request.RunID != id || run.Request.Hash == "" || run.Owner == nil {
+		t.Fatalf("sealed scheduled run: %+v, %v", run, err)
+	}
+}
