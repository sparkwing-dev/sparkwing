# Independent rules may append to the orientation table concurrently.
design/rewrite/ORIENTATION.md merge=union

# Tools compare generated files and formatted source byte for byte.
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
.shellcheckrc text eol=lf
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
.apidiff/*.txt text eol=lf
api/openapi.yaml text eol=lf
.gitleaksignore text eol=lf
pkg/wingwire/testdata/shapes.json text eol=lf
Dockerfile.* text eol=lf
AGENTS.md text eol=lf
CLAUDE.md text eol=lf
sdk/typescript/** text eol=lf
sdk/typescript/native/**/*.node binary

# Detached signatures are raw bytes; text diffs would corrupt review input.
*.sig binary
