{
  "name": "@sparkwing/sdk",
  "version": "0.0.0",
  "description": "TypeScript SDK for Sparkwing pipelines",
  "license": "Elastic-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\" \"test/**/*.test.mjs\"",
    "test:native": "go test -p 4 ./test/nativehost -run TestNative",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build && node native/check-package.mjs",
    "release:native": "node native/release.mjs bridge",
    "pack:local": "node native/release.mjs local-pack",
    "release:pack": "node native/release.mjs pack"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "types": "./index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "index.d.ts",
    "README.md",
    "native/win32-x64/protocol.node",
    "native/win32-arm64/protocol.node",
    "native/win32-x64/verification.json",
    "native/win32-arm64/verification.json"
  ],
  "publishConfig": {
    "access": "public"
  }
}
