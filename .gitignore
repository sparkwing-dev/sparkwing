# Binaries
*.exe
*.dll
*.so
*.dylib
*.test
*.out

# Command binaries dropped by `go build ./cmd/<name>` in the repo root
/apidiff
/sign-manifest
/sparkwing-cache
/sparkwing-controller
/sparkwing-logs
/sparkwing-runner
/sparkwing-web
/verify-release

# Go workspace
go.work
go.work.sum

# IDE / OS
.idea/
.vscode/
.DS_Store

# Local scratch
.claude-scratch/
.Codex-scratch/
.claude/

# Cross-compile output (regenerated by bin/cross-compile.sh)
dist/

# Next.js dashboard build output (regenerated by release.yaml + bin/build-web.sh)
internal/web/next-out/*
!internal/web/next-out/.gitkeep

# Building one internal package on its own drops its executable at the root.
/commentcheck
/doccheck

/internal/web/.build-state/

# per-worktree golangci-lint cache the delivery guidance points GOLANGCI_LINT_CACHE at
.golangci-cache/

# pipeline cache and lock files a local run writes beside the package it ran in
**/.sparkwing/cache/
