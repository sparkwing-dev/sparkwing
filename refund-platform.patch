+func TestRefundAnswersTheCapturedStripeContract(t *testing.T) {
+	c := loadCheckoutContract(t)
+	var event struct {
+		Type string `json:"type"`
+		Data struct {
+			Object json.RawMessage `json:"object"`
+		} `json:"data"`
+	}
+	if err := json.Unmarshal(c.RefundEvent, &event); err != nil {
+		t.Fatal(err)
+	}
+	var refund struct {
+		ID            string `json:"id"`
+		PaymentIntent string `json:"payment_intent"`
+		Status        string `json:"status"`
+	}
+	if err := json.Unmarshal(event.Data.Object, &refund); err != nil {
+		t.Fatal(err)
+	}
+	if event.Type != "refund.created" || refund.ID == "" || refund.PaymentIntent == "" || refund.Status != "succeeded" {
+		t.Fatalf("refund fixture: %+v", refund)
+	}
+	var object map[string]any
+	if err := json.Unmarshal(event.Data.Object, &object); err != nil {
+		t.Fatal(err)
+	}
+	stub := newRoutedStripe(t, map[string]func(url.Values) (int, map[string]any){
+		"GET /v1/payment_intents/" + refund.PaymentIntent: fixed(map[string]any{"id": refund.PaymentIntent, "object": "payment_intent", "metadata": map[string]any{DeploymentMetadata: c.Deployment, "team": "acme"}}),
+		"POST /v1/refunds": fixed(object),
+	})
+	service := c.service(t, stub.ServeHTTP)
+	request, err := json.Marshal(refundRequest{Team: "acme", Deployment: c.Deployment, PaymentIntent: refund.PaymentIntent, Key: refund.PaymentIntent, Reason: "warning"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	want, err := json.Marshal(refundResponse{Refund: refund.ID, Status: refund.Status})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for range 2 {
+		rec := c.post(service, c.Routes["refund"].Path, c.Token, request)
+		if rec.Code != http.StatusOK || !sameJSONBytes(t, rec.Body.Bytes(), want) {
+			t.Fatalf("refund = %d %s; want %s", rec.Code, rec.Body.String(), want)
+		}
+	}
+	for _, call := range stub.callsTo("POST /v1/refunds") {
+		if call.key != "refund-"+refund.PaymentIntent || call.form.Get("payment_intent") != refund.PaymentIntent {
+			t.Fatalf("refund request: %+v", call)
+		}
+	}
+}
