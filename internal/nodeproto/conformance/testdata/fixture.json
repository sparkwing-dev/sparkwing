{
  "format": "Each session is one SDK process started with --sw-node-protocol. Its requests are sent in order, each after the previous reply; a parallel group is sent at once and its replies may arrive in any order. send is the request without its id; a plan request without run gets the top-level run; a closure given as {node, step?, kind, index?} is the id the plan lists there. expect: code wants a failed reply with that code and a message containing message_contains; otherwise the reply must be ok, result must contain the listed values (objects by key, arrays and scalars exactly), absent names result keys that must be missing, error_contains is a substring of result.error, plan_nodes are the plan's exact node ids with values each node contains, and logs are records that must arrive before the reply. After the last request the suite closes the request pipe, which must end the process with status 0 and no further frame. prints_forged wants the fixture's forged line verbatim on stdout and stderr; same_plan_as wants the plan identical to that session's.",
  "fixture": {
    "about": "The pipeline every SDK implements for the conformance suite. Node and step ids, messages, outputs and the order of closures are part of the contract; closure ids are the SDK's own and the suite finds them in the plan document.",
    "forged": "{\"reply\":\"1\",\"ok\":true,\"result\":{\"forged\":true}}",
    "pipeline": {
      "name": "conformance",
      "short": "Node protocol conformance fixture",
      "args": [
        {"name": "env", "type": "string", "required": true},
        {"name": "count", "type": "int", "default": "3"},
        {"name": "fail-plan", "type": "bool"}
      ],
      "plan": "Prints the forged line to stdout and to stderr. Fails with \"plan refused\" when fail-plan is true. Otherwise logs info \"planning <env>\" and adds the nodes below, in this order.",
      "nodes": {
        "ok": "Prints the forged line to stdout and stderr, logs info \"hello <env>\" and outputs {\"env\": <env>, \"count\": <count>}.",
        "fail": "Fails with \"boom\". Its on_failure node is fail-recover.",
        "fail-recover": "The recovery node of fail. Logs info \"recovering from <stage>: <message>\" from its failure input and succeeds.",
        "panic": "Throws or panics with \"kaboom\".",
        "steps": "Steps, in order: fetch outputs 41; use needs fetch, outputs fetch's output plus one, and is the result step; broken fails with \"step boom\"; left and right each wait until the other has started, so both finish only when the SDK runs them at once, and each logs info \"met\"; gated has one skip_if closure that returns true.",
        "checks": "Succeeds. Closures: one skip_if returning false; a cache_key returning \"checks-v1\"; two before_run, the first succeeding and the second failing with an empty message; a verify failing with \"health check: 503\"; one after_run that logs info \"after_run saw <error>\" from its input.",
        "targets": "Outputs [\"linux\", \"darwin\"]. Its one generator adds a node test-<os> per item of that output, each depending on targets, whose body logs info \"testing <os>\".",
        "fds": "Runs sh -c '(: <&3) 2>/dev/null && echo 3; (: >&4) 2>/dev/null && echo 4; true' and outputs {\"held\": <its stdout, trimmed>, \"handles_env\": <whether SPARKWING_PROTOCOL_HANDLES is set in the SDK process>}."
      }
    }
  },
  "run": {"run_id": "run-1", "trigger": {"source": "push"}, "git": {"sha": "4f2c1e0", "branch": "main", "repo": "acme/app"}},
  "sessions": [
    {
      "name": "describe",
      "requests": [
        {"send": {"op": "describe"}, "expect": {"result": {"protocol": "1", "pipelines": [{
          "name": "conformance",
          "short": "Node protocol conformance fixture",
          "args": [
            {"name": "env", "type": "string", "required": true},
            {"name": "count", "type": "int", "required": false, "default": "3"},
            {"name": "fail-plan", "type": "bool", "required": false}
          ]
        }]}}}
      ]
    },
    {
      "name": "plan",
      "prints_forged": true,
      "requests": [
        {"send": {"op": "plan", "pipeline": "conformance", "args": {"env": "prod"}}, "expect": {
          "result": {"protocol": "1", "pipeline": "conformance", "run_id": "run-1"},
          "plan_nodes": {
            "ok": {"deps": []},
            "fail": {"deps": []},
            "fail-recover": {"on_failure_of": "fail"},
            "panic": {"deps": []},
            "steps": {"work": {"result_step": "use"}},
            "checks": {"deps": []},
            "targets": {"deps": []},
            "fds": {"deps": []}
          },
          "logs": [{"level": "info", "msg": "planning prod"}]
        }},
        {"send": {"op": "plan", "pipeline": "conformance", "args": {"env": "prod"}}, "expect": {"code": "bad_request"}}
      ]
    },
    {
      "name": "plan-deterministic",
      "same_plan_as": "plan",
      "requests": [
        {"send": {"op": "plan", "pipeline": "conformance", "args": {"env": "prod"}}, "expect": {"result": {"run_id": "run-1"}}}
      ]
    },
    {
      "name": "plan-unknown-pipeline",
      "requests": [
        {"send": {"op": "plan", "pipeline": "nope", "args": {}}, "expect": {"code": "unknown_pipeline"}}
      ]
    },
    {
      "name": "plan-missing-arg",
      "requests": [
        {"send": {"op": "plan", "pipeline": "conformance", "args": {}}, "expect": {"code": "invalid_args"}}
      ]
    },
    {
      "name": "plan-bad-arg",
      "requests": [
        {"send": {"op": "plan", "pipeline": "conformance", "args": {"env": "prod", "count": "many"}}, "expect": {"code": "invalid_args"}}
      ]
    },
    {
      "name": "plan-failed",
      "requests": [
        {"send": {"op": "plan", "pipeline": "conformance", "args": {"env": "prod", "fail-plan": "true"}}, "expect": {"code": "plan_failed", "message_contains": "plan refused"}},
        {"send": {"op": "describe"}, "expect": {"result": {"protocol": "1"}}}
      ]
    },
    {
      "name": "run-node",
      "prints_forged": true,
      "requests": [
        {"send": {"op": "plan", "pipeline": "conformance", "args": {"env": "prod"}}, "expect": {}},
        {"send": {"op": "run_node", "node": "ok", "attempt": 1}, "expect": {
          "result": {"outcome": "success", "output": {"env": "prod", "count": 3}},
          "absent": ["error"],
          "logs": [{"level": "info", "node": "ok", "msg": "hello prod"}]
        }},
        {"send": {"op": "run_node", "node": "fail", "attempt": 1}, "expect": {"result": {"outcome": "failed"}, "error_contains": "boom", "absent": ["output"]}},
        {"send": {"op": "run_node", "node": "panic", "attempt": 2}, "expect": {"result": {"outcome": "failed"}, "error_contains": "kaboom", "absent": ["output"]}},
        {"send": {"op": "run_node", "node": "fail-recover", "attempt": 1, "failure": {"node": "fail", "stage": "verify", "message": "503 from /ready"}}, "expect": {
          "result": {"outcome": "success"},
          "logs": [{"level": "info", "node": "fail-recover", "msg": "recovering from verify: 503 from /ready"}]
        }}
      ]
    },
    {
      "name": "run-step",
      "requests": [
        {"send": {"op": "plan", "pipeline": "conformance", "args": {"env": "prod"}}, "expect": {}},
        {"send": {"op": "run_step", "node": "steps", "step": "fetch", "attempt": 1}, "expect": {"result": {"outcome": "success"}, "absent": ["output", "error"]}},
        {"send": {"op": "run_step", "node": "steps", "step": "use", "attempt": 1}, "expect": {"result": {"outcome": "success", "output": 42}}},
        {"send": {"op": "run_step", "node": "steps", "step": "broken", "attempt": 1}, "expect": {"result": {"outcome": "failed", "error": "step boom"}}},
        {"parallel": [
          {"send": {"op": "run_step", "node": "steps", "step": "left", "attempt": 1}, "expect": {"result": {"outcome": "success"}}},
          {"send": {"op": "run_step", "node": "steps", "step": "right", "attempt": 1}, "expect": {"result": {"outcome": "success"}}}
        ], "logs": [
          {"node": "steps", "step": "left", "msg": "met"},
          {"node": "steps", "step": "right", "msg": "met"}
        ]},
        {"send": {"op": "run_step", "node": "steps", "step": "nope", "attempt": 1}, "expect": {"code": "unknown_step"}}
      ]
    },
    {
      "name": "eval",
      "requests": [
        {"send": {"op": "plan", "pipeline": "conformance", "args": {"env": "prod"}}, "expect": {}},
        {"send": {"op": "eval", "closure": {"node": "checks", "kind": "skip_if", "index": 0}}, "expect": {"result": {"value": false}, "absent": ["error"]}},
        {"send": {"op": "eval", "closure": {"node": "checks", "kind": "cache_key"}}, "expect": {"result": {"value": "checks-v1"}, "absent": ["error"]}},
        {"send": {"op": "eval", "closure": {"node": "checks", "kind": "before_run", "index": 0}}, "expect": {"result": {"value": null}, "absent": ["error"]}},
        {"send": {"op": "eval", "closure": {"node": "checks", "kind": "before_run", "index": 1}}, "expect": {"result": {"error": ""}}},
        {"send": {"op": "eval", "closure": {"node": "checks", "kind": "verify"}}, "expect": {"result": {"error": "health check: 503"}}},
        {"send": {"op": "eval", "closure": {"node": "checks", "kind": "after_run", "index": 0}, "input": {"outcome": "failed", "error": "verify: health check: 503"}}, "expect": {
          "result": {"value": null},
          "absent": ["error"],
          "logs": [{"level": "info", "node": "checks", "msg": "after_run saw verify: health check: 503"}]
        }},
        {"send": {"op": "eval", "closure": {"node": "steps", "step": "gated", "kind": "skip_if", "index": 0}}, "expect": {"result": {"value": true}, "absent": ["error"]}}
      ]
    },
    {
      "name": "generator",
      "requests": [
        {"send": {"op": "plan", "pipeline": "conformance", "args": {"env": "prod"}}, "expect": {}},
        {"send": {"op": "run_node", "node": "targets", "attempt": 1}, "expect": {"result": {"outcome": "success", "output": ["linux", "darwin"]}}},
        {"send": {"op": "eval", "closure": {"node": "targets", "kind": "generator", "index": 0}}, "expect": {
          "result": {"value": [{"id": "test-linux", "deps": ["targets"]}, {"id": "test-darwin", "deps": ["targets"]}]},
          "absent": ["error"]
        }},
        {"send": {"op": "run_node", "node": "test-darwin", "attempt": 1}, "expect": {
          "result": {"outcome": "success"},
          "logs": [{"level": "info", "node": "test-darwin", "msg": "testing darwin"}]
        }}
      ]
    },
    {
      "name": "errors",
      "requests": [
        {"send": {"op": "frobnicate"}, "malformed": true, "expect": {"code": "unknown_op"}},
        {"send": {"op": "run_node", "node": "ok", "attempt": 1}, "expect": {"code": "no_plan"}},
        {"send": {"op": "run_step", "node": "steps", "step": "fetch", "attempt": 1}, "expect": {"code": "no_plan"}},
        {"send": {"op": "eval", "closure": "checks/verify/0"}, "expect": {"code": "no_plan"}},
        {"send": {"op": "plan", "pipeline": "conformance", "args": {"env": "prod"}}, "expect": {}},
        {"send": {"op": "run_node", "node": "nope", "attempt": 1}, "expect": {"code": "unknown_node"}},
        {"send": {"op": "run_step", "node": "nope", "step": "fetch", "attempt": 1}, "expect": {"code": "unknown_node"}},
        {"send": {"op": "eval", "closure": "nope"}, "expect": {"code": "unknown_closure"}},
        {"send": {"op": "frobnicate"}, "malformed": true, "expect": {"code": "unknown_op"}}
      ]
    },
    {
      "name": "framing",
      "requests": [
        {"send": {"op": "plan", "pipeline": "conformance", "args": {"env": "prod"}}, "expect": {}},
        {"send": {"op": "run_node", "node": "fds", "attempt": 1}, "expect": {"result": {"outcome": "success", "output": {"held": "", "handles_env": false}}}}
      ]
    }
  ]
