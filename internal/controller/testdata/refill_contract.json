{
  "endpoint": "POST /internal/refill",
  "about": "The controller and the checkout service each test against a byte-for-byte copy of this file: sparkwing internal/controller/testdata and sparkwing-platform internal/billing/testdata. The request is the whole body the controller sends; each case is the checkout service's answer to one Stripe outcome.",
  "request": {
    "team": "acme",
    "deployment": "staging.sparkwing.dev",
    "refill_id": "refill_contract",
    "amount_cents": 2500,
    "customer": "cus_contract"
  },
  "cases": [
    {"name": "charged", "http_status": 200, "body": {"payment_intent": "pi_contract", "status": "succeeded"}},
    {"name": "processing", "http_status": 200, "body": {"payment_intent": "pi_contract", "status": "processing"}},
    {"name": "declined", "http_status": 200, "body": {"payment_intent": "pi_contract", "status": "requires_payment_method", "failure": "insufficient_funds"}},
    {"name": "authentication_required", "http_status": 200, "body": {"payment_intent": "pi_contract", "status": "requires_payment_method", "failure": "authentication_required"}},
    {"name": "no_card", "http_status": 409}
  ]
}
